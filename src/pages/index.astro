---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SobreMi from '../components/SobreMi.astro';
import Skills from '../components/Skills.astro';
import Formacion from '../components/Formacion.astro';
import Experiencia from '../components/Experiencia.astro';
import Proyectos from '../components/Proyectos.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Portafolio Ignacio Shishko | Vertical Glitch">
	<main class="glitch-accordion">
		<Header />
		<div class="accordion-container">
			<section class="slice about-slice">
				<div class="slice-header"><h2>ABOUT</h2></div>
				<div class="slice-content"><SobreMi /></div>
			</section>

			<section class="slice projects-slice">
				<div class="slice-header"><h2>WORK</h2></div>
				<div class="slice-content"><Proyectos /></div>
			</section>
			
			<section class="slice skills-slice">
				<div class="slice-header"><h2>TECH</h2></div>
				<div class="slice-content"><Skills /></div>
			</section>
			
			<section class="slice experience-slice">
				<div class="slice-header"><h2>XP</h2></div>
				<div class="slice-content"><Experiencia /></div>
			</section>

			<section class="slice contact-slice">
				<div class="slice-header"><h2>LINK</h2></div>
				<div class="slice-content"><Contacto /></div>
			</section>
		</div>
	</main>
	<div class="noise-overlay"></div>
</BaseLayout>

<style>
	.glitch-accordion {
		height: 100vh;
		width: 100%;
		background: #000;
		overflow: hidden;
		font-family: 'JetBrains Mono', monospace;
		position: relative;
		display: flex; /* Para centrado horizontal */
		justify-content: center;
		align-items: center;
	}
	.accordion-container {
		display: flex;
		width: 71.5vw; /* 5 slices * 14.3% del viewport */
		height: 100vh;
		margin: 0 auto;
		position: relative;
		z-index: 1;
		transition: width 0.6s cubic-bezier(0.23, 1, 0.32, 1);
	}
	/* Regla que escala el bloque entero al 100% khi there is internal hover */
	.accordion-container:has(.slice:hover) {
		width: 100vw !important;
	}

	.slice {
		flex: 0 0 14.3vw; /* Ancho inicial exacto */
		width: 14.3vw;
		height: 100%;
		border-left: 1px solid rgba(255, 0, 85, 0.3);
		transition: all 0.6s cubic-bezier(0.23, 1, 0.32, 1);
		position: relative;
		overflow: hidden;
		background: #000;
		cursor: crosshair;
	}
	
	/* Cuando el contenedor está en hover, las cajas no seleccionadas pasan a 12.5vw */
	.accordion-container:hover .slice {
		flex: 0 0 12.5vw;
		width: 12.5vw;
	}

	.slice:last-child { border-right: 1px solid rgba(255, 0, 85, 0.3); }

	/* La caja bajo el cursor mantiene el 50vw exacto */
	.slice:hover {
		flex: 0 0 50vw !important;
		width: 50vw !important;
		background: #050505;
	}
	.slice-header {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%) rotate(-90deg);
		z-index: 5;
		white-space: nowrap;
		pointer-events: none;
		transition: opacity 0.3s;
	}
	.slice:hover .slice-header { opacity: 0; }
	.slice-header h2 {
		font-size: 3rem;
		color: rgba(255, 0, 85, 0.5);
		text-transform: uppercase;
		margin: 0;
	}

	.slice-content {
		padding: 5rem 4rem 3rem 4rem; /* Padding superior solicitado a 5rem y bottom a 3rem */
		height: 100%;
		overflow-y: hidden; /* Deshabilitado para evitar saltos en la transición del acordeón */
		opacity: 0;
		transform: translateX(50px);
		transition: all 0.5s 0.3s ease;
	}
	.slice:hover .slice-content {
		opacity: 1;
		transform: translateX(0);
	}

	/* Efecto Ventana Deslizante con Revelado Izquierda -> Derecha */
	.about-slice .slice-content {
		opacity: 1 !important;
		transform: none !important;
		width: 50vw;
		min-width: 50vw;
		flex-shrink: 0;
		clip-path: inset(0 100% 0 0);
		/* Transición de salida rápida y sin delay para sincronizar con el cierre del acordeón */
		transition: clip-path 0.4s ease-out; 
	}

	.about-slice:hover .slice-content {
		clip-path: inset(0 0 0 0);
		/* Al entrar opcionalmente podés tener un delay si querés, pero para el reveal mejor directo */
		transition: clip-path 0.5s ease-in-out;
	}

	.noise-overlay {
		position: fixed; top: 0; left: 0; width: 100%; height: 100%;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
		opacity: 0.05;
		pointer-events: none;
		z-index: 1000;
	}

	@media (max-width: 900px) {
		.accordion-container { flex-direction: column; }
		.slice { height: auto; border-left: none; border-top: 1px solid rgba(255, 0, 85, 0.3); }
		.slice:hover { flex: 10; }
		.slice-header { transform: translate(-50%, -50%); }
	}
</style>
