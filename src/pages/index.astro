---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SobreMi from '../components/SobreMi.astro';
import Skills from '../components/Skills.astro';
import Experiencia from '../components/Experiencia.astro';
import Proyectos from '../components/Proyectos.astro';
import Contacto from '../components/Contacto.astro';
---

<BaseLayout title="Portafolio Ignacio Shishko | Vertical Glitch">
	<main class="glitch-accordion">
		<Header />
		<div class="accordion-container">
			<section class="slice about-slice">
				<div class="slice-header"><h2>ABOUT</h2></div>
				<div class="slice-content"><SobreMi /></div>
			</section>

			<section class="slice projects-slice">
				<div class="slice-header"><h2>WORK</h2></div>
				<div class="slice-content"><Proyectos /></div>
			</section>
			
			<section class="slice skills-slice">
				<div class="slice-header"><h2>TECH</h2></div>
				<div class="slice-content"><Skills /></div>
			</section>
			
			<section class="slice experience-slice">
				<div class="slice-header"><h2>XP</h2></div>
				<div class="slice-content"><Experiencia /></div>
			</section>

			<section class="slice contact-slice">
				<div class="slice-header"><h2>LINK</h2></div>
				<div class="slice-content"><Contacto /></div>
			</section>
		</div>
	</main>
	<div class="noise-overlay"></div>
</BaseLayout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const slices = document.querySelectorAll('.slice');
		const btnVolver = document.getElementById('btn-volver');
		
		slices.forEach(slice => {
			slice.addEventListener('click', (e) => {
				// Actuar solo si estamos en un tamaño de pantalla de celular
				if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
					// Si el panel ya está abierto, no hacemos nada extra para que dejen usar los lins de adentro
					if (slice.classList.contains('active')) return;

					// Limpiar otras instancias colgadas
					slices.forEach(s => s.classList.remove('active'));
					
					slice.classList.add('active');
					document.body.classList.add('app-open');
				}
			});
		});

		function volver() {
			const activeSlice = document.querySelector('.slice.active');
			if (!activeSlice) return;
			activeSlice.classList.add('leaving');
			activeSlice.addEventListener('animationend', () => {
				activeSlice.classList.remove('active', 'leaving');
				document.body.classList.remove('app-open');
			}, { once: true });
		}

		// En mobile/tablet (≤1024px): header-content actúa como botón de volver
		// En desktop el accordion es hover-based, no necesita acción de volver
		if (window.matchMedia('(max-width: 1024px)').matches) {
			const headerContent = document.querySelector('.header-content');
			headerContent?.addEventListener('click', () => {
				if (!document.body.classList.contains('app-open')) return;
				volver();
			});
		}
	});
</script>

<style>
	.glitch-accordion {
		height: 100vh;
		width: 100%;
		background: #000;
		overflow: hidden;
		font-family: 'JetBrains Mono', monospace;
		position: relative;
		display: flex;
		justify-content: center;
		align-items: center;
	}
	.accordion-container {
		display: flex;
		width: 71.5vw;
		height: 100vh;
		margin: 0 auto;
		position: relative;
		z-index: 1;
		transition: width 0.6s cubic-bezier(0.23, 1, 0.32, 1);
	}

	.slice {
		flex: 0 0 14.3vw;
		width: 14.3vw;
		height: 100%;
		border-left: 1px solid rgba(255, 0, 85, 0.3);
		transition: all 0.6s cubic-bezier(0.23, 1, 0.32, 1);
		position: relative;
		overflow: hidden;
		background: #000;
		cursor: crosshair;
	}
	
	.slice:last-child { border-right: 1px solid rgba(255, 0, 85, 0.3); }

	.slice-header {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%) rotate(-90deg);
		z-index: 5;
		white-space: nowrap;
		pointer-events: none;
		transition: opacity 0.3s;
	}
	
	.slice-header h2 {
		font-size: 3rem;
		color: rgba(255, 0, 85, 0.5);
		text-transform: uppercase;
		margin: 0;
	}

	.slice-content {
		padding: 5rem 4rem 3rem 4rem;
		height: 100%;
		overflow-y: hidden;
		opacity: 0;
		transform: translateX(50px);
		transition: all 0.5s 0.3s ease;
	}

	.about-slice .slice-content {
		opacity: 1 !important;
		transform: none !important;
		width: 50vw;
		min-width: 50vw;
		flex-shrink: 0;
		clip-path: inset(0 100% 0 0);
		transition: clip-path 0.4s ease-out; 
	}

	/* == INTERACCIÓN ESCRITORIO (Hover Mantenido) == */
	@media (hover: hover) and (pointer: fine) {
		.accordion-container:has(.slice:hover) {
			width: 100vw !important;
		}
		.accordion-container:hover .slice {
			flex: 0 0 12.5vw;
			width: 12.5vw;
		}
		.slice:hover {
			flex: 0 0 50vw !important;
			width: 50vw !important;
			background: #050505;
		}
		.slice:hover .slice-header { opacity: 0; }
		.slice:hover .slice-content {
			opacity: 1;
			transform: translateX(0);
		}
		.about-slice:hover .slice-content {
			clip-path: inset(0 0 0 0);
			transition: clip-path 0.5s ease-in-out;
		}
	}

	/* == ESTADO ACTIVO (Full-Screen Overlay — touch devices) == */
	.slice.active {
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		z-index: 1000;
		background: #000;
		border: none;
		overflow-y: hidden;
		overflow-x: hidden;
		animation: overlayEntry 0.35s ease-out forwards;
	}

	.slice.leaving {
		animation: overlayExit 0.25s ease-in forwards;
		pointer-events: none;
	}

	.slice.active .slice-header {
		opacity: 0;
	}

	.slice.active .slice-content {
		width: 100vw !important;
		min-width: 100vw !important;
		clip-path: none !important;
		padding-top: 6rem;
		animation: contentReveal 0.35s 0.15s ease-out both;
	}

	/* == LAYOUT MÓVIL/TABLET (20VW Horizontal Accordion) == */
	@media (max-width: 1024px) {
		.accordion-container {
			flex-direction: row;
			width: 100vw;
			height: 100vh;
		}
		.slice {
			flex: 0 0 20vw; /* 5 slices * 20vw = 100vw */
			width: 20vw;
			height: 100vh;
			border-left: 1px solid rgba(255, 0, 85, 0.3);
			border-top: none;
		}
		.slice:last-child {
			border-right: 1px solid rgba(255, 0, 85, 0.3);
		}

		.slice-header {
			transform: translate(-50%, -50%) rotate(-90deg);
		}
		.slice-header h2 {
			font-size: 2.2rem;
		}
		@media (max-width: 512px) {
			.slice-header h2 {
				font-size: 1.8rem;
			}
		}
		.slice-content {
			padding: 5rem 1.5rem 2rem 1.5rem;
		}
	}

	@keyframes overlayEntry {
		from { opacity: 0; transform: translateY(40px); }
		to   { opacity: 1; transform: translateY(0); }
	}

	@keyframes overlayExit {
		from { opacity: 1; transform: translateY(0); }
		to   { opacity: 0; transform: translateY(20px); }
	}

	@keyframes contentReveal {
		from { opacity: 0; transform: translateY(12px); }
		to   { opacity: 1; transform: translateY(0); }
	}

	.noise-overlay {
		position: fixed; top: 0; left: 0; width: 100%; height: 100%;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
		opacity: 0.05;
		pointer-events: none;
		z-index: 1000;
	}
</style>
