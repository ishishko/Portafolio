---
---
<div class="experiencia-wrapper" id="experiencia">
  <h2 class="section-title">Experiencia</h2>
  <div class="experiencia-list">
    <div class="exp-card">
      <div class="exp-header">
        <span class="exp-role">Soporte Técnico y Admin. Usuarios</span>
        <span class="exp-date">2020-Actual</span>
      </div>
      <p class="exp-company">CONABIP - Ministerio de Cultura</p>
      <p class="exp-detail">
        Soporte usuarios Windows, administración de recursos en red, VPN, BBDDs y supervisión de migraciones.
      </p>
    </div>

    <div class="exp-card">
      <div class="exp-header">
        <span class="exp-role">Desarrollador de Productos</span>
        <span class="exp-date">2016-2019</span>
      </div>
      <p class="exp-company">HiLeds Iluminación S. A.</p>
      <p class="exp-detail">
        Diseño y cálculo de productos LED, optimización de producción y especificaciones técnicas.
      </p>
    </div>
  </div>
</div>

<style>
  .experiencia-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .section-title {
    font-size: var(--fs-h3);
    margin: 0;
  }
  .experiencia-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .exp-card {
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.02);
    border-left: 3px solid var(--accent-color);
    border-radius: 0.25rem;
  }
  .exp-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.25rem;
  }
  .exp-role {
    font-weight: 700;
    font-size: var(--fs-sm);
    color: var(--text-primary);
  }
  .exp-date {
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-family: var(--font-code);
  }
  .exp-company {
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--accent-color);
    margin-bottom: 0.5rem;
  }
  .exp-detail {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }
</style>
