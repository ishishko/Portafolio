---
---
<div class="formacion-wrapper" id="formacion">
  <h2 class="section-title">Formación</h2>
  
  <div class="formacion-list">
    <div class="academica-card">
      <div class="academia-logo elizalde"></div>
      <div class="academia-info">
        <p class="p-main">Técnico en Electrónica. Esp. Informática</p>
        <p class="p-sub">2001 IPAE</p>
      </div>
    </div>

    <div class="academica-card">
      <div class="academia-logo unlam"></div>
      <div class="academia-info">
        <p class="p-main">Ingeniera Electrónica. 2° Año</p>
        <p class="p-sub">2010 UNLAM</p>
      </div>
    </div>

    <div class="academica-card">
      <div class="academia-logo one"></div>
      <div class="academia-info">
        <p class="p-main">Desarrollador FullStack</p>
        <p class="p-sub">2022 ALURA-ONE</p>
      </div>
    </div>
  </div>

  <h2 class="section-title mt-4">Cursos y Otros</h2>
  <ul class="otros-list">
    <li class="otro-item">
      <div class="otro-header">
        <img src="/assets/img/udemy.svg" alt="Udemy" class="provider-logo" />
        <p class="p-main">TypeScript Avanzado</p>
      </div>
    </li>
    <li class="otro-item">
      <div class="otro-header">
        <img src="/assets/img/pildoras.png" alt="Pildoras" class="provider-logo" />
        <p class="p-main">JavaScript Moderno</p>
      </div>
    </li>
  </ul>
</div>

<style>
  .formacion-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    height: 100%;
  }
  .section-title {
    font-size: var(--fs-h3);
    margin: 0;
  }
  .mt-4 { margin-top: 2rem; }
  
  .formacion-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  .academica-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 0.5rem;
    border: 1px solid var(--border-color);
  }
  
  .academia-logo {
    width: 40px;
    height: 40px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    flex-shrink: 0;
  }
  
  /* Logotipos existentes */
  .elizalde { background-image: url("/assets/img/elizalde.jpg"); }
  .unlam { background-image: url("/assets/img/unlam.png"); }
  .one { background-image: url("/assets/img/one.png"); }

  .p-main { font-weight: 600; font-size: var(--fs-sm); margin: 0; }
  .p-sub { font-size: 0.8rem; color: var(--text-secondary); margin: 0; }
  
  .otros-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .provider-logo {
    width: 20px;
    height: 20px;
  }
  .otro-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
</style>
