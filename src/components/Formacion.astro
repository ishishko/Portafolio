<section class="section--Formacion" id="formacion">
  <div class="formacion--container container__flex">
    <h2>Formación Académica</h2>
    <div class="formacion--academica">
      <div class="academica container__flex">
        <div class="academia--div elizalde"></div>
        <div class="academia--div--p">
          <p class="academia--p academia--p1">Técnico en Electrónica. Esp. Informática</p>
          <p class="academia--p academia--p2">2001 IPAE</p>
        </div>
      </div>
      <div class="academica container__flex">
        <div class="academia--div unlam"></div>
        <div class="academia--div--p">
          <p class="academia--p academia--p1">Universidad Nacional de la Matanza</p>
          <p class="academia--p academia--p1">Ingeniera Electrónica. 2° Año</p>
          <p class="academia--p academia--p2">2010 UNLAM</p>
        </div>
      </div>
      <div class="academica container__flex">
        <div class="academia--div one"></div>
        <div class="academia--div--p">
          <p class="academia--p academia--p1">Formación Desarrollador FullStack</p>
          <p class="academia--p academia--p2">2022 ALURA-ONE</p>
        </div>
      </div>
    </div>
    <div class="formacion--container--otros">
      <h2>Otras Formaciones</h2>
      <div class="formacion--otros">
        <ul class="otros--ul">
          <li class="otros--li">
            <div class="otros--div">
              <div class="otros--div--img">
                <img class="otros--udemy" src="/assets/img/udemy.svg" alt="Logo" />
                <img class="otros--typescript" src="/assets/img/typescript.png" alt="Logo" />
              </div>
              <div class="otros--p--titulo">
                <p class="otros--p otros--p1">Curso TypeScript</p>
                <p class="otros--p otros--p2">( Udemy )</p>
              </div>
            </div>
            <p class="otros--p otros--p2">
              - Introducción al leguaje TypeScript. Desarrollo de practicas y conocimientos avanzados de este
              Superset de JavaScript. 2022
            </p>
          </li>
          <li class="otros--li">
            <div class="otros--div">
              <div class="otros--div--img">
                <img class="otros--pildoras" src="/assets/img/udemy.svg" alt="Logo" />
                <img class="otros--pildoras" src="/assets/img/pildoras.png" alt="Logo" />
                <img class="otros--javascript" src="/assets/img/javascript.png" alt="Logo" />
              </div>
              <div>
                <div class="otros--p--titulo">
                  <p class="otros--p otros--p1">Curso JavaScript</p>
                  <p class="otros--p otros--p2">( Píldoras Informáticas )</p>
                </div>
                <div class="otros--p--titulo">
                  <p class="otros--p otros--p1">Curso JavaScript Moderno</p>
                  <p class="otros--p otros--p2">( Udemy )</p>
                </div>
              </div>
            </div>
            <p class="otros--p otros--p2">
              1 - Introducción al lenguaje JavaScript. Documentación MDN, sintaxis, POO, DOM. 2022
            </p>
            <p class="otros--p otros--p2">
              2 - Curso avanzado JavaScript Moderno. Conceptos ES6, DOM events y estandarización . REST APIS con
              JSON y Fetch API. Aplicaciones Practicas a 15 proyectos. 2022
            </p>
          </li>
          <li class="otros--li">
            <div class="otros--div">
              <div class="otros--div--img">
                <img class="otros--pildoras" src="/assets/img/udemy.svg" alt="Logo" />
                <img class="otros--workbench" src="/assets/img/workbench.jpg" alt="Logo" />
                <img class="otros--linuxvps" src="/assets/img/linuxvps.jpg" alt="Logo" />
              </div>
              <div class="otros--p--titulo">
                <p class="otros--p otros--p1">Curso MySQL Avanzado</p>
                <p class="otros--p otros--p2">( Udemy )</p>
              </div>
            </div>
            <p class="otros--p otros--p2">
              Análisis, configuración y optimización de BBDDs. Sentencias DDL, DML, DCL y configuración de base de
              datos en VPS on Cloud. 2022
            </p>
          </li>
          <li class="otros--li">
            <div class="otros--div">
              <div class="otros--div--img">
                <img class="otros--udemy" src="/assets/img/udemy.svg" alt="Logo" />
                <img class="otros--pildoras" src="/assets/img/pildoras.png" alt="Logo" />
                <img class="otros--linuxvps" src="/assets/img/git-github.png" alt="Logo" />
              </div>
              <div>
                <div class="otros--p--titulo">
                  <p class="otros--p otros--p1">Curso Git y Github</p>
                  <p class="otros--p otros--p2">( Píldoras Informáticas )</p>
                </div>
                <div class="otros--p--titulo">
                  <p class="otros--p otros--p1">Curso Git y Github Avanzado</p>
                  <p class="otros--p otros--p2">( Udemy )</p>
                </div>
              </div>
            </div>
            <p class="otros--p otros--p2">1 - Introducción y utilización básica de Git y Github. 2021</p>
            <p class="otros--p otros--p2">
              2 - Curso avanzado de Git y Github. Corrección de errores y flujo de trabajo. 2021
            </p>
          </li>
          <li class="otros--li">
            <div class="otros--div">
              <div class="otros--div--img">
                <img class="otros--pildoras" src="/assets/img/pildoras.png" alt="Logo" />
                <img class="otros--php" src="/assets/img/phplogo.jpg" alt="Logo" />
                <img class="otros--mysql" src="/assets/img/mysql.png" alt="Logo" />
              </div>
              <div class="otros--p--titulo">
                <p class="otros--p otros--p1">Curso PHP MySQL</p>
                <p class="otros--p otros--p2">( P. Informáticas Modulo 1 y 2 )</p>
              </div>
            </div>
            <p class="otros--p otros--p2">
              - Introducción al leguaje PHP. Utilización PHP MyAdmin. Creación de pagina web utilizando plataforma
              WAMPSERVER y XAMPP. 2021
            </p>
          </li>
          <li class="otros--li">
            <div class="otros--div">
              <div class="otros--div--img">
                <img class="otros--pildoras" src="/assets/img/pildoras.png" alt="Logo" />
                <img class="otros--poo" src="/assets/img/poo.jpg" alt="Logo" />
              </div>
              <div class="otros--p--titulo">
                <p class="otros--p otros--p1">Curso POO</p>
                <p class="otros--p otros--p2">( Píldoras Informáticas )</p>
              </div>
            </div>
            <p class="otros--p otros--p2">
              - Bases y fundamentos. Introducción al paradigma de la Programación Orientada a Objetos. 2020
            </p>
          </li>
          <li class="otros--li">
            <div class="otros--div">
              <div class="otros--div--img">
                <img class="otros--pildoras" src="/assets/img/pildoras.png" alt="Logo" />
                <img class="otros--sql" src="/assets/img/sql2.jpg" alt="Logo" />
                <img class="otros--mysql" src="/assets/img/mysql.png" alt="Logo" />
              </div>
              <div class="otros--p--titulo">
                <p class="otros--p otros--p1">Curso SQL - MySQL</p>
                <p class="otros--p otros--p2">( Píldoras Informáticas )</p>
              </div>
            </div>
            <p class="otros--p otros--p2">
              - Introducción al leguaje SQL, CRUD SQL y utilización PHPMyAdmin. 2020
            </p>
          </li>
          <li class="otros--li relleno"></li>
        </ul>
      </div>
    </div>
  </div>
</section>
