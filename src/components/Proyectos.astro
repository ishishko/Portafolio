---
<section class="section--proyectos" id="proyectos">
  <div class="proyectos--container container__flex">
    <h2>Proyectos</h2>
    <div class="proyectos--container--div">
      <div class="proyecto--div">
        <div class="proyecto--div--interior2">
          <div class="proyecto--interior">
            <p class="proyecto--p p1">Juego Ahorcado usando HTML, CSS y Javascrit</p>
            <p class="proyecto--p p2">Challenge ALURA-ONE</p>
          </div>
          <div class="proyecto--interior">
            <a
              href="https://github.com/ishishko/Challenge-ONE-Ahorcado"
              target="_blank"
              class="proyecto--a proyecto--a__repo proyecto--web--ahorcado"
              >Repositorio</a
            >
            <a
              href="https://ishishko.github.io/Challenge-ONE-Ahorcado/"
              target="_blank"
              class="proyecto--a proyecto--a__web proyecto--git--ahorcado"
              >Proyec. Web</a
            >
          </div>
        </div>
        <div class="proyecto--container--img">
          <div>
            <img src="/assets/img/ahorcado2.jpg" alt="ahorcado" class="proyecto--img proyecto--img__none" />
          </div>
          <div>
            <img src="/assets/img/ahorcado.jpg" alt="ahorcado" class="proyecto--img" />
          </div>
        </div>
      </div>
      <div class="proyecto--div rever">
        <div class="proyecto--container--img">
          <div>
            <img src="/assets/img/encriptador1.jpg" alt="encriptador" class="proyecto--img" />
          </div>
          <div>
            <img
              src="/assets/img/encriptador2.jpg"
              alt="encriptador"
              class="proyecto--img proyecto--img__none"
            />
          </div>
        </div>
        <div class="proyecto--div--interior1">
          <div class="proyecto--interior">
            <p class="proyecto--p p1">Encriptador usando HTML, CSS y JavaScript</p>
            <p class="proyecto--p p2">Challenge ALURA-ONE</p>
          </div>
          <div class="proyecto--interior">
            <div class="proyecto--interior">
              <a
                href="https://github.com/ishishko/Challenge-ONE-Encriptador"
                target="_blank"
                class="proyecto--a proyecto--a__repo proyecto--web--ahorcado"
                >Repositorio</a
              >
              <a
                href="https://ishishko.github.io/Challenge-ONE-Encriptador/"
                target="_blank"
                class="proyecto--a proyecto--a__web proyecto--git--ahorcado"
                >Proyec. Web</a
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
