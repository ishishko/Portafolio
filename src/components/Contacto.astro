---
---
<section class="section--contacto">
  <div class="contacto--container container__flex mobile-inner-scroll">
    <div class="contacto--img" id="contacto-img-wrapper">
      <img src={`${import.meta.env.BASE_URL}assets/img/mail.jpg`} alt="contacto" onerror="document.getElementById('contacto-img-wrapper').style.display='none'" />
    </div>
    <div class="contacto--datos">
      <h2>Contacto</h2>
      <p>¿Queres Contactarme?</p>
      <p>Completa el formulario para enviarme un mensaje.</p>
      <div class="contacto--div--formulario">
        <form class="contacto--formulario" id="form" action="https://formspree.io/f/maykagoz" method="POST">
          <div class="contacto--div--input">
            <input class="input--nombre" type="text" name="nombre" required />
            <label class="lbl--nombre">
              <span class="text--nombre">Nombre</span>
            </label>
          </div>
          <div class="contacto--div--input">
            <input class="input--email" type="email" name="email" required />
            <label class="lbl--email">
              <span class="text--email">Email</span>
            </label>
          </div>
          <div class="contacto--div--input">
            <input class="input--asunto" type="text" name="asunto" required />
            <label class="lbl--asunto">
              <span class="text--asunto">Asunto</span>
            </label>
          </div>
          <textarea
            class="contacto--textarea"
            name="mensaje"
            id=""
            cols="30"
            rows="5"
            placeholder="Mensaje"
            required
          ></textarea>
          <button class="contacto--button" type="submit">Enviar</button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const $form = document.querySelector(".contacto--formulario") as HTMLFormElement;
  $form?.addEventListener("submit", enviar);

  async function enviar(this: HTMLFormElement, e: SubmitEvent) {
    e.preventDefault();
    const form = new FormData(this);
    const response = await fetch(this.action, {
      method: this.method,
      body: form,
      headers: {
        Accept: "application/json",
      },
    });
    if (response.ok) {
      const btnEnviar = document.querySelector(".contacto--button");
      this.reset();
      if (btnEnviar) {
        btnEnviar.innerHTML = "Mensaje Enviado";
        btnEnviar.classList.add("contacto--button__ok");
        setTimeout(() => {
          btnEnviar.classList.remove("contacto--button__ok");
          btnEnviar.innerHTML = "Enviar";
        }, 2500);
      }
    }
  }
</script>
<style>
  /* Layout de sección */
  .section--contacto {
    height: 100%;
    display: flex;
    align-items: center;
  }

  .contacto--container {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 100%;
    padding: 2rem;
    width: 100%;
  }

  /* Imagen */
  .contacto--img {
    flex: 0 0 40%;
    max-height: 550px;
    overflow: hidden;
    align-self: stretch;
  }

  .contacto--img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: grayscale(1) contrast(1.2);
    mix-blend-mode: luminosity;
  }

  /* Columna de datos */
  .contacto--datos {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contacto--datos h2 {
    font-size: var(--fs-h2);
    margin: 0 0 0.5rem 0;
  }

  .contacto--datos p {
    margin: 0;
    font-size: var(--fs-body);
    color: var(--text-primary);
  }

  /* Formulario */
  .contacto--div--formulario {
    margin-top: 1rem;
  }

  .contacto--formulario {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Floating label inputs */
  .contacto--div--input {
    position: relative;
  }

  .contacto--div--input input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--accent-color);
    color: var(--text-primary);
    font-family: var(--font-main);
    font-size: var(--fs-body);
    padding: 0.4rem 0;
    outline: none;
  }

  .contacto--div--input label {
    position: absolute;
    top: 0.4rem;
    left: 0;
    color: rgba(255, 255, 255, 0.5);
    font-family: var(--font-main);
    font-size: var(--fs-body);
    pointer-events: none;
    transition: transform 0.2s ease, font-size 0.2s ease, color 0.2s ease;
  }

  .contacto--div--input input:focus ~ label,
  .contacto--div--input input:valid ~ label {
    transform: translateY(-1.4rem);
    font-size: var(--fs-sm);
    color: var(--accent-color);
  }

  .contacto--div--input input:focus {
    border-bottom-color: var(--accent-color);
    box-shadow: 0 1px 0 var(--accent-color);
  }

  /* Textarea */
  .contacto--textarea {
    width: 100%;
    background: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    font-family: var(--font-main);
    font-size: var(--fs-body);
    padding: 0.75rem;
    resize: vertical;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .contacto--textarea:focus {
    border-color: var(--accent-color);
    box-shadow: 0 0 8px rgba(255, 0, 85, 0.3);
  }

  .contacto--textarea::placeholder {
    color: rgba(255, 255, 255, 0.3);
  }

  /* Botón */
  .contacto--button {
    align-self: flex-start;
    background: transparent;
    border: 1px solid var(--accent-color);
    color: var(--accent-color);
    font-family: var(--font-main);
    font-size: var(--fs-body);
    padding: 0.6rem 2rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
  }

  .contacto--button:hover {
    background: var(--accent-color);
    color: #000;
    box-shadow: 0 0 12px var(--accent-color);
  }

  .contacto--button__ok {
    background: #00ffcc;
    border-color: #00ffcc;
    color: #000;
    box-shadow: 0 0 12px #00ffcc;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .contacto--container {
      flex-direction: column;
    }

    .contacto--img {
      flex: 0 0 auto;
      max-height: 200px;
      width: 100%;
    }

    .mobile-inner-scroll {
      max-height: 70vh;
      overflow-y: auto;
      padding-right: 10px;
    }

    .mobile-inner-scroll::-webkit-scrollbar { width: 4px; }
    .mobile-inner-scroll::-webkit-scrollbar-thumb {
      background: var(--accent-color);
      border-radius: 10px;
    }
  }

  @media (max-width: 512px) {
    .contacto--img {
      display: none;
    }
  }
</style>
