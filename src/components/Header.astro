---
---
<header class="main-header">
  <div class="header-content">
    <button class="back-btn" id="btn-volver" aria-label="Volver al menú">
      <span class="hud-bracket">[</span>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
      <span class="hud-bracket">]</span>
    </button>
    <div class="logo-icon"></div>
    <p class="brand-name">Ignacio Shishko</p>
  </div>
</header>

<style>
  .main-header {
    padding: 1.5rem 3rem;
    background: transparent;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2000;
  }
  .header-content {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .back-btn {
    background: none;
    background-color: transparent;
    border: none;
    outline: none;
    appearance: none;
    -webkit-appearance: none;
    color: var(--accent-color);
    cursor: pointer;
    padding: 0;
    margin-right: 0.75rem;
    display: none; /* Oculto por defecto */
    align-items: center;
    gap: 2px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: bold;
    transition: transform 0.2s ease, filter 0.2s ease;
  }
  .hud-bracket {
    font-size: 1.2rem;
    opacity: 0.8;
  }
  .back-btn:hover {
    transform: translateX(-3px);
    filter: drop-shadow(0 0 8px var(--accent-color));
  }
  
  /* Revelar el botón solo cuando hay una sección activa */
  :global(body.app-open) .back-btn {
    display: flex;
  }

  .logo-icon {
    width: 28px;
    height: 28px;
    background-image: url("/assets/img/programacion.png");
    background-size: contain;
    background-repeat: no-repeat;
    filter: drop-shadow(0 0 4px var(--accent-color));
  }
  .brand-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-primary);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0;
  }
  
  @media (max-width: 900px) {
    .main-header { padding: 1.5rem; }
  }
</style>
