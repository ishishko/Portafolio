---
---
<div class="skills-wrapper" id="skill">
  <div class="skill-group">
    <h2 class="section-title">Skills</h2>
      <ul class="skills-list">
        <li class="skill-item">
          <div class="skill-icon skill-icon__1"></div>
          <p>HTML 5</p>
        </li>
        <li class="skill-item">
          <div class="skill-icon skill-icon__2"></div>
          <p>CSS</p>
        </li>
        <li class="skill-item">
          <div class="skill-icon skill-icon__3"></div>
          <p>JAVASCRIPT</p>
        </li>
        <li class="skill-item">
          <div class="skill-icon skill-icon__4"></div>
          <p>S Q L</p>
        </li>
        <li class="skill-item">
          <div class="skill-icon skill-icon__5"></div>
          <p>PHP</p>
        </li>
        <li class="skill-item">
          <div class="skill-icon skill-icon__6"></div>
          <p>PYTHON</p>
        </li>
      </ul>
  </div>
</div>

<style>
  .skills-wrapper {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .section-title {
    margin-top: 0;
    font-size: var(--fs-h3);
  }
  .skills-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    gap: 1.5rem;
    padding: 0;
    list-style: none;
  }
  .skill-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
  }
  .skill-icon {
    width: 48px;
    height: 48px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    filter: drop-shadow(0 0 8px var(--accent-color));
  }
  /* Re-linking the existing images */
  .skill-icon__1 { background-image: url("/assets/img/html5.jpg"); }
  .skill-icon__2 { background-image: url("/assets/img/css.jpg"); }
  .skill-icon__3 { background-image: url("/assets/img/javascript.png"); }
  .skill-icon__4 { background-image: url("/assets/img/mysql.png"); }
  .skill-icon__5 { background-image: url("/assets/img/php.png"); }
  .skill-icon__6 { background-image: url("/assets/img/python.jpg"); }

  p {
    font-size: var(--fs-sm);
    font-weight: 500;
  }
</style>
