<style>
  .tech-wrapper {
    width: 100%;
    padding: 0 0 1rem;
    color: var(--text-primary);
  }
  .tech-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .section-title {
    font-family: "JetBrains Mono", monospace;
    font-size: var(--fs-h3);
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
    letter-spacing: -0.04em;
    margin-bottom: 1.5rem;
  }

  /* --- HABILIDADES TÉCNICAS (Grid Moderna) --- */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 3rem;
  }
  
  .cat-title {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.25;
    margin-bottom: 0.5rem;
  }

  .cat-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Píldoras Minimalistas Convertidas a Enlaces Activos */
  .skill-pill {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.4rem 0.8rem;
    background: rgba(20, 20, 20, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    color: rgba(255, 255, 255, 0.9);
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    cursor: pointer; /* Indicar reactividad de enlace */
    text-decoration: none; /* Prevenir subrayado de enlace */
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  
  .skill-pill:hover {
    background: rgba(255, 0, 85, 0.08);
    border-color: var(--accent-color);
    color: var(--text-primary);
    box-shadow: 0 4px 15px rgba(255, 0, 85, 0.2);
    transform: translateY(-3px);
  }

  .skill-pill.highlight {
    color: var(--accent-color);
    border-color: rgba(255, 0, 85, 0.4);
    background: rgba(255, 0, 85, 0.05);
  }

  /* --- CERTIFICACIONES (Tabla Real de HUD con Scroll Interno) --- */
  .cert-table-container {
    width: 100%;
    max-height: 40vh; /* Ajustado al 40% del Viewport para mayor dinamismo */
    overflow-y: auto;
    overflow-x: auto;
    background: rgba(10, 10, 10, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    padding: 0.25rem;
    
    /* Scrollbar Minimalista HUD */
    scrollbar-width: thin;
    scrollbar-color: var(--accent-color) transparent;
  }

  .cert-table-container::-webkit-scrollbar {
    width: 4px;
  }
  .cert-table-container::-webkit-scrollbar-track {
    background: transparent;
  }
  .cert-table-container::-webkit-scrollbar-thumb {
    background: var(--accent-color);
    border-radius: 10px;
    box-shadow: 0 0 5px var(--accent-color);
  }

  .cert-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 600px; /* Para forzar scroll en móviles en vez de comprimir */
  }

  .cert-table th {
    position: sticky;
    top: 0;
    z-index: 10;
    background: #000; /* Aseguramos que el fondo no sea transparente al scrollear */
    text-align: left;
    padding: 0.5rem 1.5rem;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.5);
    border-bottom: 2px solid rgba(255, 0, 85, 0.3);
    letter-spacing: 0.05em;
  }

  .cert-table td {
    padding: 0.25rem 1.5rem;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.05);
  }

  .cert-table tr:hover td {
    background: rgba(255, 255, 255, 0.02);
  }

  .cert-table tr:last-child td {
    border-bottom: none;
  }

  .cert-year {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
    color: var(--accent-color);
    font-weight: 600;
    width: 100px;
  }

  .terminal-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--text-secondary);
    text-align: center;
    width: 100%;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding-left: 60px; /* Espacio para los círculos */
    padding-right: 1rem;
  }

  @media (max-width: 512px) {
    .terminal-title {
      font-size: 0.65rem;
      padding-left: 45px;
    }
    .circles { left: 0.5rem; gap: 0.3rem }
    .circles span { width: 8px; height: 8px; }
    .skills-grid { gap: 1.5rem; }
    .cat-title { font-size: 0.95rem; }
    .skill-pill { font-size: 0.7rem; padding: 0.3rem 0.6rem; }
    .cert-year { font-size: 0.75rem; width: 60px; }
    .cert-inst { display: none; } /* Ocultar institución en móviles angostos */
    .cert-name { font-size: 0.85rem; }
    .cert-table th:nth-child(2), .cert-table td:nth-child(2) { display: none; }
    .cert-table th { font-size: 0.75rem; padding: 0.4rem 1rem; }
    .cert-table td { padding: 0.3rem 1rem; }
  }

  .highlight-text {
    color: var(--accent-color);
  }
  @media (max-width: 1024px) {
    .mobile-inner-scroll {
      max-height: 84vh;
      overflow-y: auto;
      padding-right: 10px;
      scrollbar-width: thin;
      scrollbar-color: var(--accent-color) transparent;
    }
    .mobile-inner-scroll::-webkit-scrollbar { width: 4px; }
    .mobile-inner-scroll::-webkit-scrollbar-thumb {
      background: var(--accent-color);
      border-radius: 10px;
    }
  }
</style>
